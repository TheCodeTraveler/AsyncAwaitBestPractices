<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0;$(LatestSupportedTFM)</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net462;$(TargetFrameworks);$(LatestSupportedTFM)-windows</TargetFrameworks>
        <IsPackable>false</IsPackable>
        <SignAssembly>True</SignAssembly>
        <AssemblyOriginatorKeyFile>AsyncAwaitBestPracticesUnitTests.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="NUnit" Version="5.0.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="NUnit.Analyzers" Version="4.15.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
        <PackageReference Include="coverlet.collector" Version="10.1.0" PrivateAssets="All" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\AsyncAwaitBestPractices.MVVM\AsyncAwaitBestPractices.MVVM.csproj" />
    </ItemGroup>
    <!-- The net8.0 and later targets above test the net8.0 and later assemblies, and net462 tests netstandard2.0 on .NET Framework,
         so none of them runs the .NET Standard code on .NET 8 or later, where .NET Standard plugins and apps that target an older .NET run it.
         TestedLibraryTargetFramework runs this suite against such an assembly instead, for example: dotnet test -f net10.0 -p:TestedLibraryTargetFramework=netstandard2.1
         An item definition, unlike metadata on the item above, also reaches the AsyncAwaitBestPractices reference that the SDK adds through MVVM. -->
    <ItemDefinitionGroup Condition="'$(TestedLibraryTargetFramework)' != '' AND '$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
        <ProjectReference>
            <SetTargetFramework>TargetFramework=$(TestedLibraryTargetFramework)</SetTargetFramework>
        </ProjectReference>
    </ItemDefinitionGroup>
    <ItemGroup Condition="'$(TestedLibraryTargetFramework)' != '' AND '$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
        <!-- The ConfigureAwaitOptions overloads exist only in the net8.0 and later assemblies -->
        <Compile Remove="SafeFireAndForgetTests\Tests_Task_SafeFireAndForget_ConfigureAwaitOptions.cs;SafeFireAndForgetTests\Tests_Task_SafeFireAndForgetT_ConfigureAwaitOptions.cs" />
    </ItemGroup>
</Project>