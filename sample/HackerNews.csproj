<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>HackerNews</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <!-- Runtime async for this app only: a NuGet package, like the libraries in src/, should stay classic in .NET 11, because Blazor WebAssembly runs on Mono and can't run runtime-async code.
         Roslyn needs the exact value "on", and the append form keeps any compiler feature set earlier. -->
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageReference Include="Refit.HttpClientFactory" Version="16.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\AsyncAwaitBestPractices\AsyncAwaitBestPractices.csproj" />
  </ItemGroup>
</Project>