<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* An empty icon stops the browser from requesting /favicon.ico, which this app does not serve *@
    <link rel="icon" href="data:," />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    @* No prerendering: each page initializes once, on the browser tab's circuit, where the talk's SynchronizationContext rules apply. Prerendering would run OnInitialized twice. *@
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>